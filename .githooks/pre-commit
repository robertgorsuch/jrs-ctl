#!/usr/bin/env sh
# Pre-commit hook: google-java-format (Spotless) check on the staged Java files only.
#
# Wired automatically: scripts/mvn.sh and scripts\mvn.cmd set core.hooksPath=.githooks the first
# time they run (git config core.hooksPath .githooks does the same by hand). Git runs this file
# through sh on every platform, Windows included, so there is no .cmd twin. Only the files that
# are part of the commit are checked (assessment item B3: the old hook ran Spotless over the whole
# reactor on every commit); a commit with no Java files costs nothing.
set -eu

cd "$(git rev-parse --show-toplevel)"

files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.java')
if [ -z "$files" ]; then
  exit 0
fi

# Spotless matches each -DspotlessFiles entry as a regex against the absolute path, so every
# staged path becomes ".*[\/]<path with . escaped and / accepting either separator>".
pattern=""
for f in $files; do
  esc=$(printf '%s' "$f" | sed -e 's/[.]/\\./g' -e 's#/#[\\\\/]#g')
  pattern="${pattern:+$pattern,}.*[\\\\/]$esc"
done

if [ -f scripts/mvn.sh ]; then
  MVN=scripts/mvn.sh
elif [ -f ./mvnw ]; then
  MVN=./mvnw
else
  MVN=mvn
fi

echo "pre-commit: Spotless check on $(printf '%s\n' "$files" | wc -l | tr -d ' ') staged Java file(s)"
if ! "$MVN" -q spotless:check -DspotlessFiles="$pattern"; then
  echo ""
  echo "error: Spotless formatting check failed for staged files."
  echo "Run scripts/mvn.sh spotless:apply (scripts\\mvn.cmd spotless:apply on Windows), stage, and commit again."
  exit 1
fi
