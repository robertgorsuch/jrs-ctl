{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jaspersoft.com/jrsctl/api-customizations-diff.schema.json",
  "title": "Console /api/customizations/diff (spec §13.1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["path", "originalSha256", "registeredSha256", "currentSha256", "identical", "lines"],
