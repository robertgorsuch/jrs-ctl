{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jaspersoft.com/jrsctl/passwords-status.schema.json",
  "title": "jrsctl passwords status --json (spec §10.6, ADR-0053)",
  "type": "object",
  "additionalProperties": false,
  "required": ["items", "counts", "exitCode", "passwords", "strategy"],
  "properties": {
    "items": {
      "type": "array",
      "items": { "$ref": "https://jaspersoft.com/jrsctl/report-item.schema.json#/$defs/item" }
    },
    "counts": { "$ref": "https://jaspersoft.com/jrsctl/report-item.schema.json#/$defs/counts" },
    "exitCode": { "type": "integer", "enum": [0, 2] },
    "passwords": {
      "description": "What js-ant detect-password-strategy printed; null when it printed no counts.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "modern", "legacy", "complete"],
          "properties": {
            "total": { "type": "integer", "minimum": 0 },
            "modern": { "type": "integer", "minimum": 0 },
            "legacy": { "type": "integer", "minimum": 0 },
            "complete": { "type": "boolean" }
          }
        }
      ]
    },
    "strategy": {
      "description": "password.strategy in the deployed webapp's js.password-storage-config.properties; null when the file or the key is absent.",
      "type": ["string", "null"]
    }
  }
}
