{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jaspersoft.com/jrsctl/doctor.schema.json",
  "title": "jrsctl doctor --json (spec §12.1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["items", "counts", "exitCode"],
  "properties": {
    "items": {
      "type": "array",
      "items": { "$ref": "https://jaspersoft.com/jrsctl/report-item.schema.json#/$defs/item" }
    },
    "counts": { "$ref": "https://jaspersoft.com/jrsctl/report-item.schema.json#/$defs/counts" },
    "exitCode": { "type": "integer", "enum": [0, 2, 6] }
  }
}
