{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jaspersoft.com/jrsctl/api-smoke.schema.json",
  "title": "Console /api/smoke (spec §13.1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["ranAt", "mutating", "runId", "counts", "items", "exitCode"],
  "properties": {
    "ranAt": { "type": "string", "format": "date-time" },
    "mutating": { "type": "boolean" },
    "runId": { "type": ["string", "null"] },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass", "warn", "fail", "skip"],
      "properties": {
        "pass": { "type": "integer", "minimum": 0 },
        "warn": { "type": "integer", "minimum": 0 },
        "fail": { "type": "integer", "minimum": 0 },
        "skip": { "type": "integer", "minimum": 0 }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "status", "title", "detail", "remediation", "durationMs"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "status": { "type": "string", "enum": ["PASS", "WARN", "FAIL", "SKIP"] },
          "title": { "type": "string" },
          "detail": { "type": "string" },
          "remediation": { "type": "string" },
          "durationMs": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "exitCode": { "type": "integer", "enum": [0, 2] }
  }
}
