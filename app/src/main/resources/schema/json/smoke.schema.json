{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jaspersoft.com/jrsctl/smoke.schema.json",
  "title": "jrsctl smoke --json (spec §12.2)",
  "type": "object",
  "additionalProperties": false,
  "required": ["items", "counts", "exitCode", "runId"],
  "properties": {
    "items": {
      "type": "array",
      "items": { "$ref": "https://jaspersoft.com/jrsctl/report-item.schema.json#/$defs/item" }
    },
    "counts": { "$ref": "https://jaspersoft.com/jrsctl/report-item.schema.json#/$defs/counts" },
    "exitCode": { "type": "integer", "enum": [0, 2] },
    "runId": {
      "type": ["string", "null"],
      "description": "The journaled run of the --mutating smoke plan; null when nothing was mutated."
    }
  }
}
