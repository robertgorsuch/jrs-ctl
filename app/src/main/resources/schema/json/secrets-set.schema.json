{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jaspersoft.com/jrsctl/secrets-set.schema.json",
  "title": "jrsctl secrets set --json (spec §5.2); the value is never printed",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "ref"],
  "properties": {
    "name": { "type": "string" },
    "ref": { "type": "string", "pattern": "^enc:" }
  }
}
