{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jaspersoft.com/jrsctl/api-repository.schema.json",
  "title": "Console /api/repository/tree (spec §13.1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["path", "children"],
  "properties": {
    "path": { "type": "string" },
    "children": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["uri", "label", "resourceType", "isFolder", "hasChildren"],
        "properties": {
          "uri": { "type": "string" },
          "label": { "type": "string" },
          "resourceType": { "type": "string" },
          "isFolder": { "type": "boolean" },
          "hasChildren": { "type": "boolean" }
        }
      }
    }
  }
}
