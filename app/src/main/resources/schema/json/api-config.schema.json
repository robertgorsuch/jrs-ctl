{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jaspersoft.com/jrsctl/api-config.schema.json",
  "title": "Console /api/config (spec §13.1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["server", "platform", "keys", "redactedYaml"],
  "properties": {
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseUrl",
        "webappName",
        "installDir",
        "tomcatDir",
        "serviceKind",
        "authMode",
        "username",
        "secretsConfigured"
      ],
      "properties": {
        "baseUrl": { "type": "string" },
        "webappName": { "type": "string" },
        "installDir": { "type": "string" },
        "tomcatDir": { "type": "string" },
        "serviceKind": { "type": "string" },
        "authMode": { "type": "string" },
        "username": { "type": "string" },
        "secretsConfigured": { "type": "boolean" }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "arch", "jvmVersion", "sqliteHealthy", "writeAccess"],
      "properties": {
        "os": { "type": "string" },
        "arch": { "type": "string" },
        "jvmVersion": { "type": "string" },
        "sqliteHealthy": { "type": "boolean" },
        "writeAccess": { "type": "boolean" }
      }
    },
    "keys": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "fingerprint", "bundled", "algorithm"],
        "properties": {
          "name": { "type": "string" },
          "fingerprint": { "type": "string" },
          "bundled": { "type": "boolean" },
          "algorithm": { "type": "string" }
        }
      }
    },
    "redactedYaml": { "type": "string" }
  }
}
