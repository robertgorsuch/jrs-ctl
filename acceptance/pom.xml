<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.jaspersoft.jrsctl</groupId>
    <artifactId>jrsctl-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>jrsctl-acceptance</artifactId>
  <name>jrsctl :: acceptance</name>
  <description>Phase acceptance suites. Run one phase with: mvn -pl acceptance verify -Dphase=N (tests tagged phaseN)</description>

  <properties>
    <!-- When -Dphase=N is given, only tests tagged "phaseN" run; otherwise every phase runs. -->
    <acceptance.groups/>
  </properties>

  <dependencies>
    <dependency><groupId>com.jaspersoft.jrsctl</groupId><artifactId>jrsctl-app</artifactId></dependency>
    <dependency><groupId>org.wiremock</groupId><artifactId>wiremock</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.testcontainers</groupId><artifactId>testcontainers</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.testcontainers</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <forkCount>1</forkCount>
          <reuseForks>true</reuseForks>
          <groups>${acceptance.groups}</groups>
          <excludedGroups>${excluded.groups}</excludedGroups>
          <systemPropertyVariables>
            <jrsctl.jar>${project.basedir}/../app/target/jrsctl.jar</jrsctl.jar>
            <jrsctl.java>${java.home}/bin/java</jrsctl.java>
            <jrsctl.version>${project.version}</jrsctl.version>
            <jrsctl.acceptanceDir>${project.basedir}</jrsctl.acceptanceDir>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>single-phase</id>
      <activation><property><name>phase</name></property></activation>
      <properties>
        <acceptance.groups>phase${phase}</acceptance.groups>
      </properties>
    </profile>
  </profiles>
</project>
